{
  "name": "ingenieurbuero-kaltbrunn-redesign",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "astro build",
    "verify": "npm run check && npm run typecheck && npm run lint && npm run format:check && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.4",
    "gsap": "3.15.0",
    "motion": "13.1.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "eslint": "10.9.0",
    "eslint-plugin-astro": "1.7.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
