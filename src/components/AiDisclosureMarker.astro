---
interface Props {
  href?: string;
  ariaLabel?: string;
}

const {
  href = '#ki-hinweis-leistungen',
  ariaLabel = 'Hinweis zu teilweise KI-generierten illustrativen Darstellungen',
} = Astro.props;
---

<sup class="ai-disclosure-marker">
  <a href={href} aria-label={ariaLabel}>¹</a>
</sup>

<style>
  .ai-disclosure-marker {
    display: inline;
    margin-left: 0.12em;
    font-size: 0.42em;
    font-weight: 650;
    line-height: 0;
    vertical-align: super;
  }

  .ai-disclosure-marker a {
    color: currentColor;
    opacity: 0.68;
    text-decoration: none;
    transition: opacity var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .ai-disclosure-marker a:hover,
  .ai-disclosure-marker a:focus-visible {
    opacity: 1;
  }
</style>
