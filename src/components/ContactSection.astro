---
import { business } from '@data/business';
import { contactContent } from '@data/home-content';

const privacyHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/datenschutz/`;
---

<section class="contact" id="kontakt" aria-labelledby="contact-heading">
  <div class="contact__inner container-wide">
    <div class="contact__information">
      <p class="contact__eyebrow">Kontakt</p>
      <h2 id="contact-heading">{contactContent.heading}</h2>
      <p class="contact__introduction">{contactContent.introduction}</p>

      <div class="contact__person">
        <strong>{business.owner}</strong>
        <span>Ingenieur (B. Eng.) · freier Kfz-Sachverständiger</span>
      </div>

      <dl class="contact__details">
        <div>
          <dt>Adresse</dt>
          <dd>
            {business.address.street}<br />
            {`${business.address.postalCode} ${business.address.city}`}
          </dd>
        </div>
        <div>
          <dt>Telefon</dt>
          <dd><a href={business.phone.href}>{business.phone.display}</a></dd>
        </div>
        <div>
          <dt>E-Mail</dt>
          <dd><a href={business.email.href}>{business.email.address}</a></dd>
        </div>
        <div>
          <dt>Öffnungszeiten</dt>
          <dd>{business.openingHours.display}</dd>
        </div>
      </dl>
    </div>

    <div class="contact__form-area">
      <h3>{contactContent.formHeading}</h3>

      <form class="contact-form" data-contact-form>
        <div class="contact-form__field">
          <label for="k-name">Name</label>
          <input
            id="k-name"
            name="name"
            type="text"
            placeholder="Max Mustermann"
            autocomplete="name"
            required
          />
        </div>

        <div class="contact-form__field">
          <label for="k-telefon">Telefonnummer</label>
          <input
            id="k-telefon"
            name="phone"
            type="tel"
            placeholder="+49 176 1234567"
            autocomplete="tel"
            required
          />
        </div>

        <div class="contact-form__field">
          <label for="k-email">E-Mail-Adresse</label>
          <input
            id="k-email"
            name="email"
            type="email"
            placeholder="max@beispiel.de"
            autocomplete="email"
            required
          />
        </div>

        <div class="contact-form__field">
          <label for="k-fahrzeug">
            Kennzeichen / Fahrzeug <span>optional</span>
          </label>
          <input
            id="k-fahrzeug"
            name="vehicle"
            type="text"
            placeholder="z. B. HP-XX 123 · BMW X1"
          />
        </div>

        <div class="contact-form__field">
          <label for="k-nachricht">Ihre Nachricht</label>
          <textarea
            id="k-nachricht"
            name="message"
            placeholder="Was ist passiert? Fahrzeug, Schaden, Wunschtermin – ein paar Sätze genügen."
            required></textarea>
        </div>

        <label class="contact-form__consent">
          <input name="consent" type="checkbox" required />
          <span>
            Ich habe die <a href={privacyHref}>Datenschutzerklärung</a>
            gelesen und bin mit der Verarbeitung meiner Daten zur Bearbeitung meiner
            Anfrage einverstanden.
          </span>
        </label>

        <button type="submit">Jetzt kostenlose Erstanfrage senden →</button>
      </form>
    </div>
  </div>
</section>

<script>
  import { initializeContactForm } from '@scripts/contact-form';

  initializeContactForm();
</script>

<style>
  .contact {
    scroll-margin-top: calc(var(--header-height) + 2rem);
    margin: 0 1rem 1rem;
    padding-block: clamp(7rem, 11vw, 11rem);
    border-radius: 1.75rem;
    background: var(--color-surface-subtle);
    color: var(--color-text);
  }

  .contact__inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(4rem, 8vw, 8rem);
  }

  .contact__information h2 {
    max-width: 11ch;
    margin: 1.25rem 0 0;
    color: var(--color-text);
    font-size: var(--font-size-section-heading);
    font-weight: 610;
    letter-spacing: -0.065em;
    line-height: 0.92;
    text-wrap: balance;
  }

  .contact__eyebrow {
    margin: 0;
    color: var(--color-brand);
    font-size: 0.9rem;
    font-weight: 690;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
  }

  .contact__introduction {
    max-width: 36rem;
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
    color: var(--color-text-muted);
    font-size: clamp(1.05rem, 1.35vw, 1.3rem);
    line-height: 1.58;
  }

  .contact__person {
    display: grid;
    gap: 0.25rem;
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .contact__person strong {
    color: var(--color-text);
    font-size: 1.25rem;
    letter-spacing: -0.025em;
  }

  .contact__person span {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .contact__details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    margin: 2rem 0 0;
  }

  .contact__details div {
    min-width: 0;
  }

  .contact__details dt {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .contact__details dd {
    margin: 0.45rem 0 0;
    color: var(--color-text);
    line-height: 1.5;
  }

  .contact__details a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .contact__form-area {
    padding: clamp(1.75rem, 3vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background: var(--color-background);
  }

  .contact__form-area h3 {
    margin: 0 0 1.5rem;
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 700;
  }

  .contact-form {
    display: grid;
    gap: 1rem;
  }

  .contact-form__field {
    display: grid;
    gap: 0.4rem;
  }

  .contact-form label {
    color: var(--color-text);
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.015em;
  }

  .contact-form__field label span {
    color: var(--color-text-muted);
    font-weight: 450;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    padding: 0.85rem 0.95rem;
    background: var(--color-background);
    color: var(--color-text);
    font: inherit;
    font-size: 0.95rem;
    outline: none;
    transition:
      border-color var(--motion-duration-fast) var(--motion-ease-standard),
      box-shadow var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .contact-form textarea {
    min-height: 7rem;
    resize: vertical;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    border-color: var(--color-focus);
    box-shadow: 0 0 0 3px rgb(0 61 165 / 10%);
  }

  .contact-form__consent {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: var(--color-text-muted) !important;
    line-height: 1.5;
  }

  .contact-form__consent input {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    margin-top: 0.15rem;
  }

  .contact-form__consent a {
    color: var(--color-brand);
  }

  .contact-form button {
    width: max-content;
    min-height: var(--button-height);
    margin-top: 0.25rem;
    border: 1px solid var(--color-brand);
    border-radius: var(--button-radius);
    padding-inline: var(--button-padding-inline);
    background: var(--color-brand);
    color: var(--color-background);
    font: inherit;
    font-size: var(--button-font-size);
    font-weight: var(--button-font-weight);
    cursor: pointer;
  }

  .contact-form button:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  .contact-form button:disabled {
    opacity: 0.78;
    cursor: wait;
  }

  @media (max-width: 56rem) {
    .contact {
      margin-inline: 0.5rem;
      border-radius: 1rem;
    }

    .contact__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .contact {
      padding-block: 6.5rem 9rem;
    }

    .contact__details {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .contact__form-area {
      padding: 1.35rem;
    }

    .contact-form input,
    .contact-form textarea {
      font-size: 1rem;
    }

    .contact-form button {
      width: 100%;
    }
  }
</style>
