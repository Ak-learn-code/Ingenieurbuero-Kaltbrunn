---
import heroImage from '@assets/images/hero/audi-front-vermessung-anonymisiert.png';
import { heroContent } from '@data/home-content';
import HeroContact from './HeroContact.astro';

const heroHeadingWords = heroContent.heading.split(' ');
const heroHeadingSegments = heroHeadingWords.flatMap((word, wordIndex) => {
  const hyphenSegments = word.match(/[^-]+-?/g) ?? [word];

  return hyphenSegments.map((text, segmentIndex) => ({
    text,
    spaceAfter:
      segmentIndex === hyphenSegments.length - 1 &&
      wordIndex < heroHeadingWords.length - 1,
  }));
});
---

<section class="hero" id="hero" aria-labelledby="hero-heading">
  <div class="hero__copy-panel">
    <div class="hero__copy" data-hero-copy>
      <div
        class="hero__review-proof"
        aria-label={heroContent.reviewProof.label}
      >
        <svg class="hero__google-mark" aria-hidden="true" viewBox="0 0 24 24">
          <path
            fill="#4285f4"
            d="M21.6 12.23c0-.71-.06-1.4-.18-2.05H12v3.87h5.38a4.6 4.6 0 0 1-2 3.02v2.51h3.24c1.89-1.74 2.98-4.31 2.98-7.35Z"
          ></path>
          <path
            fill="#34a853"
            d="M12 22c2.7 0 4.96-.9 6.62-2.42l-3.24-2.51c-.89.6-2.04.96-3.38.96-2.6 0-4.81-1.76-5.6-4.13H3.07v2.6A10 10 0 0 0 12 22Z"
          ></path>
          <path
            fill="#fbbc05"
            d="M6.4 13.9A6 6 0 0 1 6.09 12c0-.66.11-1.3.31-1.9V7.5H3.07A10 10 0 0 0 2 12c0 1.61.39 3.14 1.07 4.5l3.33-2.6Z"
          ></path>
          <path
            fill="#ea4335"
            d="M12 5.97c1.47 0 2.79.5 3.83 1.5l2.86-2.86A9.6 9.6 0 0 0 12 2a10 10 0 0 0-8.93 5.5l3.33 2.6c.79-2.37 3-4.13 5.6-4.13Z"
          ></path>
        </svg>
        <span class="hero__review-stars" aria-hidden="true">★★★★★</span>
        <span class="hero__review-label">{heroContent.reviewProof.label}</span>
      </div>

      <h1 id="hero-heading" aria-label={heroContent.heading}>
        {
          heroHeadingSegments.map(({ text, spaceAfter }, index) => (
            <>
              <span class="hero__heading-word-clip" aria-hidden="true">
                <span
                  class="hero__heading-word"
                  style={`--hero-word-index: ${index}`}
                >
                  {text}
                </span>
              </span>
              {spaceAfter && ' '}
            </>
          ))
        }
      </h1>
      <p>{heroContent.subheading}</p>

      <div class="hero__actions" aria-label="Direkteinstiege">
        <a class="hero__primary-action" href={heroContent.primaryCta.href}>
          <span class="hero__action-label--desktop">
            {heroContent.primaryCta.label}
          </span>
          <span class="hero__action-label--mobile">
            {heroContent.primaryCta.mobileLabel}
          </span>
        </a>
        <a class="hero__secondary-action" href={heroContent.secondaryCta.href}>
          <span class="hero__action-label--desktop">
            {heroContent.secondaryCta.label}
          </span>
          <span class="hero__action-label--mobile">
            {heroContent.secondaryCta.mobileLabel}
          </span>
        </a>
      </div>
    </div>
  </div>

  <div class="hero__media" data-hero-media>
    <picture>
      <img
        src={heroImage.src}
        alt="Frontansicht eines Audi mit Maßstab zur Fahrzeugdokumentation"
        width={heroImage.width}
        height={heroImage.height}
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>
</section>

<HeroContact />

<style>
  .hero {
    position: relative;
    width: auto;
    height: calc(100svh - 3.75rem);
    min-height: 39rem;
    overflow: hidden;
    margin: 2.75rem 1rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 1.75rem;
    background: #171d29;
    color: var(--color-background);
  }

  .hero__copy-panel {
    position: relative;
    z-index: 2;
    height: 100%;
    padding-inline: var(--page-gutter);
    color: var(--color-background);
  }

  .hero__copy-panel::before {
    position: absolute;
    z-index: 0;
    inset: 0 auto 0 0;
    width: min(76rem, 78%);
    background: linear-gradient(
      90deg,
      rgba(9, 14, 23, 0.88) 0%,
      rgba(9, 14, 23, 0.68) 48%,
      rgba(9, 14, 23, 0.22) 78%,
      rgba(9, 14, 23, 0) 100%
    );
    content: '';
    pointer-events: none;
  }

  .hero__copy {
    position: relative;
    z-index: 1;
    display: grid;
    width: min(100%, 76rem);
    height: 100%;
    margin-inline: auto;
    align-content: center;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto auto auto;
    gap: 0;
    padding: 7.5rem 0 2rem;
    animation: hero-copy-enter 720ms 100ms var(--motion-ease-emphasized) both;
  }

  .hero h1 {
    width: min(100%, 23ch);
    align-self: start;
    grid-column: 1;
    grid-row: 2;
    margin: 0;
    font-size: clamp(3.25rem, 4.7vw, 4.5rem);
    font-weight: 620;
    letter-spacing: -0.052em;
    line-height: 0.96;
    text-wrap: pretty;
  }

  .hero__heading-word-clip {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
  }

  .hero__heading-word {
    display: inline-block;
    animation: hero-heading-word-enter 680ms var(--motion-ease-emphasized) both;
    animation-delay: calc(140ms + (var(--hero-word-index) * 52ms));
    transform: translate3d(0, 112%, 0);
    will-change: transform;
  }

  .hero__copy > p {
    max-width: 36rem;
    align-self: start;
    grid-column: 1;
    grid-row: 3;
    margin: 1.5rem 0 0;
    color: rgba(255, 255, 255, 0.76);
    font-size: clamp(0.9rem, 1vw, 1rem);
    line-height: 1.55;
  }

  .hero__actions {
    display: grid;
    width: max-content;
    max-width: 100%;
    align-self: start;
    justify-self: start;
    grid-column: 1;
    grid-row: 4;
    grid-template-columns: repeat(2, auto);
    gap: 0.75rem;
    margin: 1.75rem 0 0;
  }

  .hero__review-proof {
    display: inline-flex;
    width: max-content;
    max-width: 100%;
    align-items: center;
    grid-column: 1;
    grid-row: 1;
    gap: 0.55rem;
    margin-bottom: 1rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.875rem;
    font-weight: 680;
    line-height: 1;
  }

  .hero__google-mark {
    width: 1.125rem;
    height: 1.125rem;
    flex: 0 0 auto;
  }

  .hero__review-stars {
    color: var(--color-background);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .hero__review-label {
    color: rgba(255, 255, 255, 0.86);
    white-space: nowrap;
  }

  .hero__primary-action,
  .hero__secondary-action {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    border: 1px solid transparent;
    border-radius: var(--radius-small);
    padding: 0.75rem 1.2rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: var(--letter-spacing-ui);
    line-height: 1.25;
    text-decoration: none;
    transition:
      background-color var(--motion-duration-fast) ease,
      transform var(--motion-duration-fast) ease;
  }

  .hero__primary-action {
    border-color: var(--color-brand);
    background: var(--color-brand);
    color: var(--color-background);
  }

  .hero__primary-action:hover {
    border-color: var(--color-brand-deep);
    background: var(--color-brand-deep);
  }

  .hero__secondary-action {
    border-color: rgba(255, 255, 255, 0.68);
    background: rgba(9, 14, 23, 0.42);
    color: var(--color-background);
  }

  .hero__secondary-action:hover {
    border-color: var(--color-background);
    background: rgba(9, 14, 23, 0.62);
  }

  .hero__primary-action:active,
  .hero__secondary-action:active {
    transform: translateY(1px);
  }

  .hero__primary-action:focus-visible,
  .hero__secondary-action:focus-visible {
    outline-color: var(--color-background);
  }

  .hero__primary-action span,
  .hero__secondary-action span {
    font-weight: 720;
  }

  .hero__action-label--mobile {
    display: none;
  }

  .hero__media {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    background: #171d29;
    animation: hero-media-enter 900ms var(--motion-ease-emphasized) both;
  }

  .hero__media::after {
    position: absolute;
    inset: 0;
    background: rgba(0, 38, 102, 0.34);
    content: '';
  }

  .hero__media picture,
  .hero__media img {
    width: 100%;
    height: 100%;
  }

  .hero__media img {
    object-fit: cover;
    object-position: 50% 50%;
    transform: scale(1.015);
    animation: hero-image-settle 1100ms 80ms var(--motion-ease-emphasized) both;
  }

  @keyframes hero-copy-enter {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-media-enter {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes hero-heading-word-enter {
    from {
      transform: translate3d(0, 112%, 0);
    }

    to {
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes hero-image-settle {
    from {
      transform: scale(1.055);
    }

    to {
      transform: scale(1.015);
    }
  }

  @media (max-width: 68rem) {
    .hero {
      height: calc(100svh - 3.25rem);
      margin: 2.75rem 0.5rem 0.5rem;
      border-radius: 1rem;
    }

    .hero__media img {
      object-position: 76% 50%;
    }

    .hero__copy-panel {
      padding: calc(var(--header-height) + 2.75rem) var(--page-gutter) 1.5rem;
    }

    .hero__copy-panel::before {
      width: 100%;
      background: linear-gradient(
        180deg,
        rgba(9, 14, 23, 0.82) 0%,
        rgba(9, 14, 23, 0.68) 46%,
        rgba(9, 14, 23, 0.18) 78%,
        rgba(9, 14, 23, 0) 100%
      );
    }

    .hero__copy {
      width: 100%;
      align-content: start;
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto auto;
      gap: 0;
      padding: 0;
    }

    .hero h1 {
      width: min(100%, 12ch);
      grid-column: 1;
      grid-row: 2;
      font-size: clamp(2.45rem, 9.5vw, 4.5rem);
      line-height: 0.98;
    }

    .hero__copy > p {
      max-width: 36rem;
      grid-column: 1;
      grid-row: 3;
      margin: 1.1rem 0 0;
      font-size: clamp(0.9rem, 3.75vw, 1.05rem);
    }

    .hero__actions {
      width: 100%;
      justify-self: start;
      grid-column: 1;
      grid-row: 4;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.55rem;
      margin-top: 0.85rem;
    }

    .hero__review-proof {
      margin-bottom: 0.8rem;
      font-size: 0.75rem;
    }

    .hero__review-stars {
      font-size: 0.7rem;
    }

    .hero__primary-action,
    .hero__secondary-action {
      min-height: 2.9rem;
      display: grid;
      align-content: center;
      justify-items: center;
      padding: 0.4rem 0.65rem;
      font-size: 0.8rem;
    }

    .hero__action-label--desktop {
      display: none;
    }

    .hero__action-label--mobile {
      display: inline;
    }
  }

  @media (max-width: 30rem) {
    .hero__copy-panel {
      padding-top: calc(var(--header-height) + 2.25rem);
      padding-bottom: 1rem;
    }

    .hero h1 {
      font-size: clamp(2.15rem, 10.6vw, 3.2rem);
    }

    .hero__copy > p {
      line-height: 1.5;
    }

    .hero__actions {
      gap: 0.5rem;
      margin-top: 0.8rem;
    }

    .hero__primary-action,
    .hero__secondary-action {
      min-height: 2.75rem;
      padding: 0.35rem 0.55rem;
    }
  }

  @media (max-width: 22rem) {
    .hero h1 {
      font-size: clamp(2rem, 10.2vw, 2.35rem);
    }

    .hero__copy > p {
      font-size: 0.84rem;
    }

    .hero__actions {
      gap: 0.5rem 0.55rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__copy,
    .hero__media,
    .hero__media img,
    .hero__heading-word {
      animation: none;
      transform: none;
    }

    .hero__heading-word {
      will-change: auto;
    }

    .hero__primary-action,
    .hero__secondary-action {
      transition: none;
    }
  }
</style>
