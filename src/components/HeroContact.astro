---
import portrait from '@assets/images/portraits/nurettin-square.webp';
import { business, person } from '@data/business';
import { heroContactContent } from '@data/home-content';
---

<aside
  class="hero-contact"
  aria-hidden="true"
  aria-label={`Direkter WhatsApp-Kontakt zu ${person.name}`}
  data-hero-contact
  data-visible="false"
  inert
>
  <a
    class="hero-contact__link"
    href={business.phone.whatsapp}
    target="_blank"
    rel="noreferrer"
    aria-label={`${person.name} direkt per WhatsApp kontaktieren`}
  >
    <div class="hero-contact__identity">
      <img
        src={portrait.src}
        alt={`Nurettin Sogukcesme, ${person.jobTitle}`}
        width={portrait.width}
        height={portrait.height}
        loading="eager"
        decoding="async"
      />
      <div class="hero-contact__details">
        <strong>{person.name}</strong>
        <span>{heroContactContent.qualification}</span>
        <small>{heroContactContent.localRole}</small>
      </div>
    </div>

    <div class="hero-contact__action">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
        ></path>
      </svg>
      <span>Direkt per WhatsApp schreiben</span>
    </div>
  </a>
</aside>

<script>
  import { initializeHeroContact } from '@scripts/hero-contact';

  initializeHeroContact();
</script>

<style>
  .hero-contact {
    position: fixed;
    z-index: 35;
    right: 1rem;
    bottom: 1rem;
    width: min(20.5rem, calc(100vw - 2rem));
    opacity: 0;
    pointer-events: none;
    transform: translate3d(calc(100% + 1.5rem), 0, 0);
    transition:
      transform 280ms cubic-bezier(0.23, 1, 0.32, 1),
      opacity 280ms cubic-bezier(0.23, 1, 0.32, 1);
    will-change: transform, opacity;
  }

  .hero-contact[data-visible='true'] {
    opacity: 1;
    pointer-events: auto;
    transform: translate3d(0, 0, 0);
  }

  .hero-contact__link {
    display: block;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-large);
    background: #171d29;
    box-shadow: 0 0.75rem 2rem rgba(9, 14, 23, 0.24);
    color: var(--color-background);
    text-decoration: none;
    transition:
      border-color var(--motion-duration-fast) ease,
      transform var(--motion-duration-fast) ease;
  }

  .hero-contact__identity {
    display: grid;
    align-items: center;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0.7rem;
    padding: 0.75rem;
  }

  .hero-contact__identity img {
    width: 3rem;
    height: 3rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: var(--radius-medium);
    object-fit: cover;
  }

  .hero-contact__details {
    display: grid;
    min-width: 0;
  }

  .hero-contact__details strong {
    font-size: 0.9375rem;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .hero-contact__details span {
    margin-top: 0.15rem;
    overflow: hidden;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.625rem;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hero-contact__details small {
    margin-top: 0.2rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.005em;
    line-height: 1.3;
  }

  .hero-contact__action {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    padding: 0.55rem 0.75rem;
    background: var(--color-whatsapp);
    color: #0a321b;
    font-size: 0.75rem;
    font-weight: 720;
    letter-spacing: var(--letter-spacing-ui);
  }

  .hero-contact__action svg {
    width: 1.1rem;
    height: 1.1rem;
    flex: 0 0 auto;
    fill: currentColor;
  }

  .hero-contact__link:focus-visible {
    outline-color: var(--color-background);
  }

  .hero-contact__link:active {
    transform: scale(0.99);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-contact__link:hover {
      border-color: rgba(255, 255, 255, 0.42);
    }

    .hero-contact__link:hover .hero-contact__action {
      background: var(--color-whatsapp-deep);
    }
  }

  @media (max-width: 40rem) {
    .hero-contact {
      right: 0.5rem;
      bottom: max(0.5rem, env(safe-area-inset-bottom));
      width: min(20.75rem, calc(100vw - 1rem));
    }

    .hero-contact__link {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 3.25rem;
      box-shadow: none;
    }

    .hero-contact__identity {
      grid-template-columns: 2.35rem minmax(0, 1fr);
      gap: 0.5rem;
      padding: 0.45rem 0.55rem;
    }

    .hero-contact__identity img {
      width: 2.35rem;
      height: 2.35rem;
    }

    .hero-contact__details strong {
      overflow: hidden;
      font-size: 0.8rem;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .hero-contact__details span {
      display: none;
    }

    .hero-contact__details small {
      margin-top: 0.15rem;
      overflow: hidden;
      font-size: 0.5625rem;
      line-height: 1.2;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .hero-contact__action {
      min-height: 3.25rem;
      border-top: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.16);
      padding: 0;
    }

    .hero-contact__action span {
      display: none;
    }

    .hero-contact__action svg {
      width: 1.25rem;
      height: 1.25rem;
    }
  }

  @media (max-width: 22rem) {
    .hero-contact__details span {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-contact,
    .hero-contact__link {
      transition: none;
    }
  }
</style>
