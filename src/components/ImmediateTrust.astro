---
import portrait from '@assets/images/portraits/nurettin-square.webp';
import {
  aboutContent,
  heroContactContent,
  trustFacts,
  whyReasons,
} from '@data/home-content';
import { education, qualifications } from '@data/qualifications';
import { Image } from 'astro:assets';

const independence = whyReasons.find(
  ({ id }) => id === 'echte-unabhaengigkeit',
)!;
const directContact = whyReasons.find(({ id }) => id === 'direkter-draht')!;
const specialistQualifications = qualifications.filter(
  ({ id }) => id !== 'beng-maschinenbau',
);
---

<section
  class="immediate-trust"
  id="warum-ich"
  aria-labelledby="immediate-trust-heading"
>
  <div class="immediate-trust__layout container-wide">
    <header class="immediate-trust__intro">
      <p class="immediate-trust__eyebrow">
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
        >
          <path
            d="M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7.5-1.5a3 3 0 1 0 0-6m-13 17v-1.25A5.25 5.25 0 0 1 8.75 14h.5a5.25 5.25 0 0 1 5.25 5.25v1.25m2-6.25a4.5 4.5 0 0 1 4 4.47v1.78"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span>{independence.title}</span>
      </p>

      <h2 id="immediate-trust-heading">{aboutContent.heading}</h2>
      <p class="immediate-trust__lead">{independence.description}</p>

      <a class="immediate-trust__cta" href="#ihr-recht">Ihr Recht ansehen</a>
    </header>

    <div class="immediate-trust__stage">
      <div class="immediate-trust__canvas">
        <div class="immediate-trust__column immediate-trust__column--left">
          <article class="immediate-trust__card">
            <h3>Ausbildung</h3>
            <p>{education[0]}</p>
            <p>{education[1]}</p>
          </article>

          <article class="immediate-trust__card immediate-trust__card--copy">
            <p>{aboutContent.paragraphs[0]}</p>
          </article>

          <article class="immediate-trust__card">
            <h3>{directContact.title}</h3>
            <p>{directContact.description}</p>
          </article>
        </div>

        <div class="immediate-trust__profile-column">
          <article class="immediate-trust__profile-card">
            <div class="immediate-trust__portrait-frame">
              <Image
                src={portrait}
                alt="Nurettin Sogukcesme, Ingenieur und Kfz-Sachverständiger"
                width={portrait.width}
                height={portrait.height}
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="immediate-trust__profile-caption">
              <strong>{aboutContent.name}</strong>
              <span>{heroContactContent.qualification}</span>
              <span>{heroContactContent.localRole}</span>
            </div>
          </article>

          <article class="immediate-trust__card immediate-trust__card--copy">
            <p>{aboutContent.paragraphs[1]}</p>
          </article>
        </div>

        <div class="immediate-trust__column immediate-trust__column--right">
          <article class="immediate-trust__card">
            <h3>Qualifikationen</h3>
            <ul>
              {specialistQualifications.map(({ title }) => <li>{title}</li>)}
            </ul>
          </article>

          <dl
            class="immediate-trust__facts"
            aria-label="Erfahrung und Erreichbarkeit"
          >
            {
              trustFacts.map((fact) => (
                <div class="immediate-trust__card immediate-trust__fact">
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .immediate-trust {
    position: relative;
    overflow: hidden;
    scroll-margin-top: calc(var(--header-height) + 2rem);
    padding-block: clamp(6rem, 9vw, 9rem);
    background: var(--color-background);
    color: var(--color-text);
  }

  .immediate-trust__layout {
    display: grid;
    align-items: center;
    grid-template-columns: minmax(0, 0.72fr) minmax(36rem, 1.28fr);
    gap: clamp(3.5rem, 6vw, 6.5rem);
  }

  .immediate-trust__intro {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    text-align: left;
  }

  .immediate-trust__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    color: var(--color-text);
    font-size: clamp(0.95rem, 1.25vw, 1.1rem);
    font-weight: 650;
    letter-spacing: -0.025em;
  }

  .immediate-trust__eyebrow svg {
    flex: 0 0 auto;
  }

  .immediate-trust__intro h2 {
    max-width: 11ch;
    margin: clamp(1.5rem, 2.5vw, 2rem) 0 0;
    color: var(--color-text);
    font-size: var(--font-size-section-heading);
    font-weight: 590;
    letter-spacing: -0.062em;
    line-height: 0.95;
    text-wrap: balance;
  }

  .immediate-trust__lead {
    max-width: 33rem;
    margin: clamp(1.5rem, 2.5vw, 2rem) 0 0;
    color: #303641;
    font-size: clamp(1.05rem, 1.45vw, 1.28rem);
    line-height: 1.58;
    text-wrap: pretty;
  }

  .immediate-trust__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--button-height);
    margin-top: clamp(2rem, 3vw, 2.5rem);
    padding-inline: 1.65rem;
    border: 1px solid var(--color-brand);
    border-radius: var(--button-radius);
    background: var(--color-brand);
    color: #fff;
    font-size: var(--button-font-size);
    font-weight: var(--button-font-weight);
    letter-spacing: var(--letter-spacing-ui);
    text-decoration: none;
    transition:
      background-color var(--motion-duration-fast) var(--motion-ease-standard),
      border-color var(--motion-duration-fast) var(--motion-ease-standard),
      transform var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .immediate-trust__cta:hover {
    border-color: var(--color-brand-deep);
    background: var(--color-brand-deep);
    transform: translateY(-2px);
  }

  .immediate-trust__cta:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  .immediate-trust__stage {
    position: relative;
    overflow: hidden;
    height: clamp(34rem, 43vw, 38rem);
    margin: 0;
    padding-top: 0.5rem;
    mask-image: linear-gradient(to bottom, #000 0%, #000 84%, transparent 100%);
  }

  .immediate-trust__stage::before,
  .immediate-trust__stage::after {
    display: none;
  }

  .immediate-trust__canvas {
    display: grid;
    align-items: start;
    grid-template-columns: minmax(0, 1fr) minmax(11.5rem, 0.96fr) minmax(
        0,
        1fr
      );
    gap: clamp(0.75rem, 1.2vw, 1.1rem);
  }

  .immediate-trust__column,
  .immediate-trust__profile-column {
    display: grid;
    gap: 0.85rem;
  }

  .immediate-trust__column--left,
  .immediate-trust__column--right {
    padding-top: clamp(1.5rem, 2.5vw, 2.5rem);
  }

  .immediate-trust__card,
  .immediate-trust__profile-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background: var(--color-background);
  }

  .immediate-trust__card {
    padding: clamp(0.9rem, 1.25vw, 1.15rem);
  }

  .immediate-trust__card h3 {
    margin: 0;
    color: var(--color-text);
    font-size: clamp(0.9rem, 1vw, 1rem);
    font-weight: 680;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .immediate-trust__card p,
  .immediate-trust__card li {
    color: var(--color-text-muted);
    font-size: clamp(0.76rem, 0.85vw, 0.86rem);
    line-height: 1.5;
  }

  .immediate-trust__card p {
    margin: 0.65rem 0 0;
  }

  .immediate-trust__card--copy p {
    margin-top: 0;
  }

  .immediate-trust__card ul {
    display: grid;
    gap: 0.6rem;
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  .immediate-trust__card li + li {
    padding-top: 0.6rem;
    border-top: 1px solid var(--color-border);
  }

  .immediate-trust__profile-card {
    overflow: hidden;
    padding: 0.45rem;
    box-shadow: 0 1rem 2rem rgb(21 23 26 / 10%);
  }

  .immediate-trust__portrait-frame {
    overflow: hidden;
    width: 100%;
    aspect-ratio: 1;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: var(--color-background);
  }

  .immediate-trust__portrait-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .immediate-trust__profile-caption {
    display: grid;
    gap: 0.25rem;
    padding: 0.85rem 0.65rem 0.7rem;
    text-align: center;
  }

  .immediate-trust__profile-caption strong {
    color: var(--color-text);
    font-size: clamp(0.95rem, 1.15vw, 1.1rem);
    font-weight: 690;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }

  .immediate-trust__profile-caption span {
    color: var(--color-text-muted);
    font-size: 0.68rem;
    line-height: 1.4;
  }

  .immediate-trust__facts {
    display: grid;
    gap: 0.85rem;
    margin: 0;
  }

  .immediate-trust__fact {
    display: flex;
    min-height: 5.75rem;
    flex-direction: column;
    justify-content: space-between;
  }

  .immediate-trust__fact dt,
  .immediate-trust__fact dd {
    margin: 0;
  }

  .immediate-trust__fact dt {
    color: var(--color-text-muted);
    font-size: 0.72rem;
    font-weight: 570;
    line-height: 1.35;
  }

  .immediate-trust__fact dd {
    order: -1;
    color: var(--color-brand);
    font-size: clamp(1.75rem, 2.25vw, 2.45rem);
    font-weight: 690;
    letter-spacing: -0.065em;
    line-height: 0.9;
  }

  @media (max-width: 68rem) {
    .immediate-trust__layout {
      grid-template-columns: 1fr;
      gap: 4.5rem;
    }

    .immediate-trust__intro {
      align-items: center;
      text-align: center;
    }

    .immediate-trust__intro h2 {
      max-width: 19ch;
    }

    .immediate-trust__lead {
      max-width: 58rem;
      text-wrap: balance;
    }

    .immediate-trust__stage {
      width: 100%;
      max-width: 50rem;
      justify-self: center;
    }
  }

  @media (max-width: 58rem) {
    .immediate-trust__layout {
      gap: 3.5rem;
    }

    .immediate-trust__stage {
      height: auto;
      padding-block: 0 5.5rem;
      mask-image: none;
    }

    .immediate-trust__stage::before,
    .immediate-trust__stage::after {
      display: none;
    }

    .immediate-trust__canvas {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .immediate-trust__profile-column {
      order: 1;
      width: 100%;
    }

    .immediate-trust__column--left {
      order: 2;
    }

    .immediate-trust__column--right {
      order: 3;
    }

    .immediate-trust__column--left,
    .immediate-trust__column--right {
      padding-top: 0;
    }

    .immediate-trust__profile-card {
      display: grid;
      align-items: center;
      grid-template-columns: minmax(8rem, 0.75fr) minmax(0, 1.25fr);
    }

    .immediate-trust__profile-caption {
      padding: 1.15rem;
      text-align: left;
    }

    .immediate-trust__facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .immediate-trust__fact {
      min-height: 7rem;
    }
  }

  @media (max-width: 40rem) {
    .immediate-trust {
      padding-block: clamp(4.5rem, 15vw, 5.5rem) 0;
    }

    .immediate-trust__eyebrow {
      gap: 0.6rem;
      font-size: 0.9rem;
    }

    .immediate-trust__eyebrow svg {
      width: 21px;
      height: 21px;
    }

    .immediate-trust__intro h2 {
      max-width: 13ch;
      margin-top: 1.35rem;
      line-height: 0.98;
    }

    .immediate-trust__lead {
      margin-top: 1.5rem;
      font-size: 1rem;
      text-wrap: pretty;
    }

    .immediate-trust__cta {
      margin-top: 2rem;
    }

    .immediate-trust__stage {
      margin-top: 0;
      padding-bottom: 4.5rem;
    }

    .immediate-trust__profile-card {
      grid-template-columns: minmax(6.75rem, 0.72fr) minmax(0, 1.28fr);
    }

    .immediate-trust__profile-caption strong {
      font-size: 1.08rem;
    }

    .immediate-trust__profile-caption span {
      font-size: 0.76rem;
    }

    .immediate-trust__facts {
      gap: 0.6rem;
    }

    .immediate-trust__fact {
      min-height: 6.5rem;
      padding: 1rem;
    }

    .immediate-trust__fact dd {
      font-size: clamp(1.9rem, 10vw, 2.7rem);
    }

    .immediate-trust__fact dt {
      font-size: 0.69rem;
    }
  }

  @media (max-width: 22rem) {
    .immediate-trust__intro h2 {
      font-size: var(--font-size-section-heading);
    }

    .immediate-trust__profile-card {
      grid-template-columns: 6.15rem minmax(0, 1fr);
    }

    .immediate-trust__profile-caption {
      padding: 0.85rem;
    }

    .immediate-trust__profile-caption strong {
      font-size: 0.95rem;
    }

    .immediate-trust__profile-caption span {
      font-size: 0.67rem;
    }

    .immediate-trust__facts {
      grid-template-columns: 1fr;
    }

    .immediate-trust__fact {
      min-height: 5.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .immediate-trust__cta {
      transition: none;
    }

    .immediate-trust__cta:hover {
      transform: none;
    }
  }
</style>
