---
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';

interface Props {
  eyebrow: string;
  title: string;
  introduction: string;
}

const { eyebrow, title, introduction } = Astro.props;
---

<a class="skip-link" href="#main-content">Zum Inhalt springen</a>
<Header />

<main class="legal-page" id="main-content">
  <header class="legal-page__hero">
    <div class="legal-page__hero-inner container-reading">
      <p>{eyebrow}</p>
      <h1>{title}</h1>
      <span>{introduction}</span>
    </div>
  </header>

  <article class="legal-page__document container-reading">
    <slot />
  </article>
</main>

<Footer />

<style>
  .legal-page {
    background: var(--color-background);
    color: var(--color-text);
  }

  .legal-page__hero {
    margin: 0 1rem;
    padding-block: clamp(10rem, 17vw, 14rem) clamp(5rem, 8vw, 7rem);
    border-radius: 0 0 1.75rem 1.75rem;
    background: #171d29;
    color: var(--color-background);
  }

  .legal-page__hero-inner > p {
    margin: 0;
    color: rgb(255 255 255 / 62%);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    line-height: 1;
    text-transform: uppercase;
  }

  .legal-page__hero h1 {
    margin: 1.25rem 0 0;
    color: var(--color-background);
    font-size: clamp(3.15rem, 7vw, 6.6rem);
    font-weight: 610;
    letter-spacing: -0.07em;
    line-height: 0.92;
  }

  .legal-page__hero span {
    display: block;
    max-width: 44rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    color: rgb(255 255 255 / 68%);
    font-size: clamp(1rem, 1.35vw, 1.22rem);
    line-height: 1.6;
  }

  .legal-page__document {
    padding-block: clamp(5rem, 9vw, 8rem) clamp(7rem, 12vw, 11rem);
  }

  .legal-page__document :global(h2) {
    margin: clamp(4rem, 7vw, 6rem) 0 0;
    padding-top: 1.35rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: clamp(1.5rem, 2.6vw, 2.15rem);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1.08;
  }

  .legal-page__document :global(h2:first-child) {
    margin-top: 0;
  }

  .legal-page__document :global(p) {
    max-width: 48rem;
    margin: 1.15rem 0 0;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 1.15vw, 1.08rem);
    line-height: 1.72;
  }

  .legal-page__document :global(strong) {
    color: var(--color-text);
    font-weight: 650;
  }

  .legal-page__document :global(a) {
    color: var(--color-brand);
    text-decoration-color: rgb(0 61 165 / 32%);
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--motion-duration-fast)
      var(--motion-ease-standard);
  }

  .legal-page__document :global(a:hover) {
    text-decoration-color: currentColor;
  }

  @media (max-width: 48rem) {
    .legal-page__hero {
      margin-inline: 0.5rem;
      padding-block: 8.75rem 4.5rem;
      border-radius: 0 0 1rem 1rem;
    }

    .legal-page__hero h1 {
      font-size: clamp(2.8rem, 15vw, 4.25rem);
    }

    .legal-page__document {
      padding-block: 4.5rem 7rem;
    }

    .legal-page__document :global(h2) {
      margin-top: 3.5rem;
    }
  }
</style>
